# WhateverOPS — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Full docs: docs/06-Development/ENV-VARS.md

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
CACHE_BACKEND=memory          # memory | redis
RAILWAY_RUN_AS_SERVICE=true   # Prevent Railway from sleeping the service

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=                 # vercel.com → Account Settings → Tokens

# ── Railway ───────────────────────────────────────────────────────────────────
RAILWAY_TOKEN=                # railway.app → Account → Tokens. Requires 'Member' scope minimum. Regenerate at railway.app → Account → Tokens if expired.

# ── Neon ──────────────────────────────────────────────────────────────────────
NEON_API_KEY=                 # Must be a valid API key (not a connection string). Get from console.neon.tech → Settings → API Keys
NEON_CONNECTION_STRING=       # Your project → Connection Details → Direct

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_PAT=                   # github.com/settings/tokens (repo:read, read:user)
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-repo

# ── PostHog ───────────────────────────────────────────────────────────────────
POSTHOG_PROJECT_API_KEY=      # app.posthog.com → Project Settings → API Keys
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=

# ── Linear ────────────────────────────────────────────────────────────────────
LINEAR_API_KEY=               # linear.app → Settings → API
LINEAR_TEAM_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=               # platform.openai.com → API keys
OPENAI_ORG_ID=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=                 # Must include protocol, e.g. https://xxxxx.supabase.co — Your project → Settings → API → Project URL
SUPABASE_ANON_KEY=            # Settings → API → anon public
SUPABASE_SERVICE_KEY=         # service_role key — used for Auth admin API. Settings → API → service_role (keep secret)
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_KEY=      # Access Token for Management API (api.supabase.com/v1) — NOT the service_role key. Get from supabase.com/dashboard → Account → Access Tokens

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=               # resend.com → API Keys
RESEND_FROM_EMAIL=hi@yourdomain.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # dashboard.stripe.com → Developers → API keys
STRIPE_WEBHOOK_SECRET=        # Phase 5+ only

# ── Sentry (integration) ──────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=            # sentry.io → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=         # dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ── Replit ────────────────────────────────────────────────────────────────────
REPLIT_API_KEY=

# ── Upstash Redis (Phase 2+) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth Secrets (Phase 4+) — generate: openssl rand -hex 32 ─────────────────
CREDENTIAL_ENCRYPTION_KEY=
LUCIA_SECRET=
N8N_WEBHOOK_SECRET=

# ── OAuth (Phase 4+) ──────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (Phase 4+) ───────────────────────────────────────────────────────
DATABASE_URL=                 # Neon pooled connection (app)
DATABASE_URL_UNPOOLED=        # Neon direct connection (migrations)

# ── Admin (Phase 4+) ──────────────────────────────────────────────────────────
ADMIN_USER_IDS=               # Comma-separated user IDs

# ── WhateverOPS own Sentry (Phase 5+) ────────────────────────────────────────
SENTRY_DSN=

# ── Frontend env (Vercel, VITE_ prefix required) ─────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
