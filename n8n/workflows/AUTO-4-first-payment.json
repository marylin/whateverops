{
  "name": "AUTO-4: First Payment Auto-Post",
  "description": "Stripe first-ever payment → auto-post (no approval, once-only)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-payment",
        "authentication": "headerAuth",
        "headerAuth": {
          "name": "x-webhook-secret",
          "value": "={{$env.STRIPE_WEBHOOK_SECRET}}"
        },
        "responseMode": "onReceived",
        "responseCode": 200
      },
      "name": "Stripe Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.type}}",
              "operation": "equals",
              "value2": "checkout.session.completed"
            }
          ]
        }
      },
      "name": "Is Payment Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "// Check static variable to ensure once-only behavior\nconst staticData = $getWorkflowStaticData('global');\nif (staticData.firstPaymentPosted) {\n  return [];\n}\nstaticData.firstPaymentPosted = true;\nconst amount = ($json.data?.object?.amount_total || 0) / 100;\nreturn [{ json: { amount, currency: $json.data?.object?.currency || 'usd', isFirst: true } }];"
      },
      "name": "Check First Payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "url": "https://api.bufferapp.com/1/updates/create.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.BUFFER_ACCESS_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"First paying customer! After months of building WhateverOPS in public, someone found it valuable enough to pay for it. This means everything. Thank you. \\ud83d\\ude4f\", \"profile_ids\": [\"{{$env.BUFFER_PROFILE_ID}}\"]}"
      },
      "name": "Auto-Post to Buffer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [910, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.RESEND_FROM_EMAIL}}",
        "toEmail": "={{$env.ADMIN_EMAIL}}",
        "subject": "FIRST PAYMENT RECEIVED!",
        "htmlBody": "=<h1>First payment!</h1><p>Amount: ${{$node['Check First Payment'].json.amount}} {{$node['Check First Payment'].json.currency}}</p><p>An auto-post has been sent to Buffer. No approval needed for this one.</p>"
      },
      "name": "Notify Admin",
      "type": "n8n-nodes-base.resend",
      "typeVersion": 1,
      "position": [910, 500]
    }
  ],
  "connections": {
    "Stripe Webhook": {
      "main": [[{ "node": "Is Payment Event", "type": "main", "index": 0 }]]
    },
    "Is Payment Event": {
      "main": [[{ "node": "Check First Payment", "type": "main", "index": 0 }], []]
    },
    "Check First Payment": {
      "main": [
        [
          { "node": "Auto-Post to Buffer", "type": "main", "index": 0 },
          { "node": "Notify Admin", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "automation" }, { "name": "social" }, { "name": "milestone" }]
}
