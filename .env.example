# WhateverOPS — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# See each section for where to get API keys.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
CACHE_BACKEND=memory          # memory | redis
RAILWAY_RUN_AS_SERVICE=true   # Prevent Railway from sleeping the service

# Logging (optional — defaults to 'info')
# LOG_LEVEL=debug

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=                 # vercel.com → Account Settings → Tokens

# ── Railway ───────────────────────────────────────────────────────────────────
RAILWAY_TOKEN=                # railway.app → Account → Tokens. Requires 'Member' scope minimum. Regenerate at railway.app → Account → Tokens if expired.

# ── Neon ──────────────────────────────────────────────────────────────────────
NEON_API_KEY=                 # Must be a valid API key (not a connection string). Get from console.neon.tech → Settings → API Keys

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_PAT=                   # github.com/settings/tokens (repo:read, read:user)
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-repo

# ── PostHog ───────────────────────────────────────────────────────────────────
POSTHOG_PERSONAL_API_KEY=     # app.posthog.com → User Settings → Personal API Keys (phx_ prefix)
                              # Must be a personal API key with Query Read scope, NOT a project API key
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=

# ── Linear ────────────────────────────────────────────────────────────────────
LINEAR_API_KEY=               # linear.app → Settings → API
LINEAR_TEAM_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys
ANTHROPIC_ADMIN_API_KEY=      # (optional) console.anthropic.com → Admin API Keys — for usage/billing data

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=               # platform.openai.com → API keys
OPENAI_ORG_ID=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_ACCESS_TOKEN=        # supabase.com/dashboard → Account (avatar) → Access Tokens → Generate
                              # Single token powers Management, Auth, and Storage cards
                              # No per-project keys needed — auto-discovers all projects
SUPABASE_EXCLUDE_PROJECTS=    # (optional) Comma-separated project refs to skip from auto-discovery

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=               # resend.com → API Keys
RESEND_FROM_EMAIL=hi@yourdomain.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # dashboard.stripe.com → Developers → API keys

# ── Sentry (integration) ──────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=            # sentry.io → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=         # dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=        # (optional) dash.cloudflare.com → URL contains account ID

# ── Upstash Redis (Phase 2+) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── WhateverOPS own Sentry (optional) ────────────────────────────────────────
SENTRY_DSN=

# ── Frontend env (Vercel, VITE_ prefix required) ─────────────────────────────
VITE_API_URL=http://localhost:3000  # Must match backend PORT
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
