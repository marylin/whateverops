{
  "name": "AUTO-2: GitHub Stars Milestone",
  "description": "Hourly cron → GitHub stars → milestone check → Claude draft → Resend approval → post",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      },
      "name": "Hourly Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$env.GITHUB_REPO_OWNER}}/{{$env.GITHUB_REPO_NAME}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.GITHUB_PAT}}" },
            { "name": "Accept", "value": "application/vnd.github.v3+json" }
          ]
        }
      },
      "name": "Get Repo Stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "const stars = $input.first().json.stargazers_count;\nconst milestones = [10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000];\nconst hit = milestones.find(m => stars >= m && stars < m + (m <= 100 ? 5 : m <= 1000 ? 25 : 100));\nif (hit) {\n  return [{ json: { stars, milestone: hit, repo: $input.first().json.full_name } }];\n}\nreturn [];"
      },
      "name": "Check Milestone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{$env.ANTHROPIC_API_KEY}}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":512,\"messages\":[{\"role\":\"user\",\"content\":\"Write a short, authentic social post (under 280 chars) celebrating hitting {{$json.milestone}} GitHub stars on {{$json.repo}}. Be genuine, not corporate. Mention the community.\"}]}"
      },
      "name": "Claude Draft Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [910, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.RESEND_FROM_EMAIL}}",
        "toEmail": "={{$env.ADMIN_EMAIL}}",
        "subject": "=Stars milestone: {{$node['Check Milestone'].json.milestone}} stars!",
        "htmlBody": "=<h2>{{$node['Check Milestone'].json.milestone}} stars on {{$node['Check Milestone'].json.repo}}!</h2><h3>Draft post:</h3><pre>{{$json.content[0].text}}</pre><p><a href='{{$env.N8N_BASE_URL}}/webhook/approve-post?id={{$executionId}}&type=stars'>Approve & Post</a> | <a href='{{$env.N8N_BASE_URL}}/webhook/reject-post?id={{$executionId}}'>Skip</a></p>"
      },
      "name": "Send Approval Email",
      "type": "n8n-nodes-base.resend",
      "typeVersion": 1,
      "position": [1130, 300]
    }
  ],
  "connections": {
    "Hourly Check": {
      "main": [[{ "node": "Get Repo Stats", "type": "main", "index": 0 }]]
    },
    "Get Repo Stats": {
      "main": [[{ "node": "Check Milestone", "type": "main", "index": 0 }]]
    },
    "Check Milestone": {
      "main": [[{ "node": "Claude Draft Post", "type": "main", "index": 0 }]]
    },
    "Claude Draft Post": {
      "main": [[{ "node": "Send Approval Email", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "automation" }, { "name": "social" }]
}
